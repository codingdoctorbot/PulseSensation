+			or ALERT_SLOT_FALLBACK
+		if slots <= 0 then
+			slots = ALERT_SLOT_FALLBACK
+		end
+		local worst = 0
+		for index = 1, slots do
+			local status = GetInventoryAlertStatus(index)
+			if not issecretvalue(status) and type(status) == "number" and status > worst then
+				worst = status
