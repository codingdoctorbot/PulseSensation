# Standalone: does not call into PulseHaptics and works without it. OptionalDeps only orders
# the load so both addons settle the shared combat-text active unit predictably (see README).
# Textures are generated by scripts/make-comic-art.py.
Kapow.lua
# Prototype: on-screen hit meter (/kapow meter). Engine-computed damage/health bars.
Meter.lua
# Art catalog (Art/ holds the three-frame sequences), events and their looks, drawing.
ArtCatalog.lua
# Generated sound pools (Kapow/Sounds/<pool>/, scripts/make-sound-catalog.py).
SoundCatalog.lua
Art.lua
Events.lua
Display.lua
# Themes: Classic, Comic chaos, Roadfighter, Shadow Clan, Boomer Shooter, Strike Squad, Soccer League.
Themes.lua
# Profiles: account-wide list, per-character choice, export / import.
Profiles.lua
# Arena-shooter banners (FIRST BLOOD, DOUBLE KILL, MVP ...) and a kill feed.
Announcer.lua
# Optional detection sources: combat-log colours, target death event, damage meter, kill statistic.
Detect.lua
# "Accurate" hit attribution (swings, casts, school, ticks, pet), condensed from MikScrollingBattleText.
Attribution.lua
